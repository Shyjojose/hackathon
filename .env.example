# Copy this file to .env and fill in the values.
# NEVER commit .env — it is in .gitignore.

# ── NVIDIA (same key, two variable names for different consumers) ───────────
NVIDIA_API_KEY=
NVIDIA_INFERENCE_API_KEY=

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=          # Your Telegram numeric user ID(s), comma-separated

# ── Lambda Labs GPU hosting ─────────────────────────────────────────────────
LAMBDA_API_KEY=

# ── GitHub (scoped to the hackathon repo only) ──────────────────────────────
GITHUB_TOKEN=

# ── MCP tunnel (Cloudflare or ngrok — set once tunnel domain is known) ──────
MCP_TUNNEL_DOMAIN=             # e.g. thesisclaw.trycloudflare.com
MCP_BEARER_TOKEN=              # Full-access /mcp endpoint token
VOICE_MCP_BEARER_TOKEN=        # Read-only /voice-mcp endpoint token

# ── Xiaozhi ESP32-S3 voice bridge ───────────────────────────────────────────
MCP_ENDPOINT=                  # Xiaozhi MCP WebSocket URL
